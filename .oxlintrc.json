{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "vitest", "unicorn", "oxc"],
  "jsPlugins": ["@stylistic/eslint-plugin"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "builtin": true,
    "es2024": true,
    "node": true
  },
  "ignorePatterns": ["node_modules", "dist", "build", "coverage", ".astro"],
  "overrides": [
    {
      "files": ["**/*.{test,spec}.{ts,tsx}"],
      "rules": {
        "unicorn/consistent-function-scoping": "off"
      }
    },
    {
      "files": [
        "packages/core/src/policies/switches.ts",
        "packages/core/src/workflow/presets.ts",
        "packages/core/src/workflow/resolve.ts",
        "packages/office/src/chat/desk.ts",
        "packages/office/src/engine/**"
      ],
      "rules": {
        "eslint/complexity": "off",
        "eslint/max-depth": "off"
      }
    },
    {
      "files": [
        "packages/agent/src/office-client/client.ts",
        "packages/agent/src/repos/clone.ts",
        "packages/agent/src/repos/workspaces.ts",
        "packages/agent/src/runner/__tests__/loop.test.ts",
        "packages/agent/src/runner/attachments.ts",
        "packages/agent/src/runner/chat-replies.ts",
        "packages/agent/src/runner/chat.ts",
        "packages/agent/src/runner/identity.ts",
        "packages/agent/src/runner/item-env.ts",
        "packages/agent/src/runner/loop.ts",
        "packages/agent/src/runner/prompt.ts",
        "packages/agent/src/runner/startup-chat.ts",
        "packages/agent/src/runner/startup.ts",
        "packages/agent/src/runner/work.ts",
        "packages/agent/src/tools/install.ts",
        "packages/agent/src/verbs/env.ts",
        "packages/agent/src/verbs/files.ts",
        "packages/agent/src/verbs/http.ts",
        "packages/agent/src/verbs/me.ts",
        "packages/agent/src/verbs/mentions.ts",
        "packages/agent/src/verbs/merge.ts",
        "packages/agent/src/verbs/office-verbs.ts",
        "packages/agent/src/verbs/pr-checks.ts",
        "packages/agent/src/verbs/pr-merge.ts",
        "packages/agent/src/verbs/pr-review.ts",
        "packages/agent/src/verbs/pr-write.ts",
        "packages/agent/src/verbs/pr.ts",
        "packages/agent/src/verbs/ticket-create.ts",
        "packages/cli/src/__tests__/doctor.test.ts",
        "packages/cli/src/commands/build.ts",
        "packages/cli/src/commands/diff.ts",
        "packages/cli/src/commands/doctor.ts",
        "packages/cli/src/commands/doctor/network.ts",
        "packages/cli/src/commands/doctor/office.ts",
        "packages/cli/src/commands/doctor/scope.ts",
        "packages/cli/src/commands/doctor/secrets.ts",
        "packages/cli/src/commands/doctor/tools.ts",
        "packages/cli/src/commands/eject.ts",
        "packages/cli/src/commands/explain.ts",
        "packages/cli/src/commands/fire.ts",
        "packages/cli/src/commands/git-credential.ts",
        "packages/cli/src/commands/hire.ts",
        "packages/cli/src/commands/hire/grants.ts",
        "packages/cli/src/commands/hire/person.ts",
        "packages/cli/src/commands/hire/setup-step.ts",
        "packages/cli/src/commands/render.ts",
        "packages/cli/src/commands/role.ts",
        "packages/cli/src/commands/setup.ts",
        "packages/cli/src/commands/setup/derive.ts",
        "packages/cli/src/commands/team.ts",
        "packages/cli/src/commands/upgrade.ts",
        "packages/cli/src/commands/validate.ts",
        "packages/cli/src/commands/verbs.ts",
        "packages/cli/src/commands/workflow.ts",
        "packages/cli/src/ejected.ts",
        "packages/cli/src/load.ts",
        "packages/core/src/acts/apply.ts",
        "packages/office/src/link/client.ts",
        "packages/office/src/link/events.ts",
        "packages/office/src/pipeline/conditions.ts",
        "packages/office/src/pipeline/configure.ts",
        "packages/office/src/pipeline/decide.ts",
        "packages/office/src/pipeline/derive.ts",
        "packages/office/src/pipeline/describe.ts",
        "packages/office/src/pipeline/instructions.ts",
        "packages/office/src/pipeline/replay/replay.ts",
        "packages/protocol/src/codec.ts",
        "packages/protocol/src/docs-format.ts",
        "packages/protocol/src/docs.ts",
        "packages/protocol/src/link/codec.ts",
        "packages/protocol/src/work-groups.ts"
      ],
      "rules": {
        "eslint/complexity": "off",
        "eslint/max-depth": "off"
      }
    }
  ],
  "rules": {
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css"]
      }
    ],
    "curly": ["error", "all"],
    "arrow-body-style": ["error", "as-needed"],
    "@stylistic/no-multiple-empty-lines": [
      "error",
      {
        "max": 1,
        "maxBOF": 0,
        "maxEOF": 0
      }
    ],
    "@stylistic/padding-line-between-statements": [
      "error",
      {
        "blankLine": "always",
        "prev": ["if", "for", "while", "do", "try", "switch"],
        "next": "*"
      },
      {
        "blankLine": "always",
        "prev": "multiline-const",
        "next": "*"
      },
      {
        "blankLine": "always",
        "prev": "multiline-let",
        "next": "*"
      },
      {
        "blankLine": "always",
        "prev": "multiline-var",
        "next": "*"
      },
      {
        "blankLine": "always",
        "prev": "multiline-expression",
        "next": "*"
      },
      {
        "blankLine": "always",
        "prev": "multiline-block-like",
        "next": "*"
      },
      {
        "blankLine": "always",
        "prev": "multiline-export",
        "next": "*"
      },
      {
        "blankLine": "always",
        "prev": "block-like",
        "next": "return"
      }
    ],
    "@stylistic/lines-around-comment": [
      "error",
      {
        "beforeBlockComment": true,
        "beforeLineComment": false,
        "afterBlockComment": false,
        "afterLineComment": false,
        "allowBlockStart": true,
        "allowClassStart": true,
        "allowObjectStart": true,
        "allowArrayStart": true,
        "allowInterfaceStart": true,
        "allowTypeStart": true,
        "allowEnumStart": true,
        "allowModuleStart": true,
        "applyDefaultIgnorePatterns": true
      }
    ],
    "eslint/complexity": [
      "error",
      {
        "max": 8
      }
    ],
    "eslint/max-depth": [
      "error",
      {
        "max": 3
      }
    ]
  }
}
