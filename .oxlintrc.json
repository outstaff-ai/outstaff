{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "vitest", "unicorn", "oxc"],
  "jsPlugins": ["@stylistic/eslint-plugin"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "builtin": true,
    "es2024": true,
    "node": true
  },
  "ignorePatterns": ["node_modules", "dist", "build", "coverage", ".astro"],
  "overrides": [
    {
      "files": ["**/*.{test,spec}.{ts,tsx}"],
      "rules": {
        "unicorn/consistent-function-scoping": "off"
      }
    },
    {
      "files": [
        "packages/core/src/policies/switches.ts",
        "packages/core/src/workflow/presets.ts",
        "packages/core/src/workflow/resolve.ts",
        "packages/office/src/chat/desk.ts",
        "packages/office/src/engine/**"
      ],
      "rules": {
        "eslint/complexity": "off",
        "eslint/max-depth": "off"
      }
    },
    {
      "files": [
        "packages/cli/src/commands/explain.ts",
        "packages/core/src/acts/apply.ts",
        "packages/core/src/catalog/context.ts",
        "packages/core/src/catalog/load.ts",
        "packages/core/src/catalog/template-parse.ts",
        "packages/core/src/catalog/template.ts",
        "packages/core/src/config/load.ts",
        "packages/core/src/config/locate.ts",
        "packages/core/src/config/network.ts",
        "packages/core/src/config/validate.ts",
        "packages/core/src/docs/schema-walk.ts",
        "packages/core/src/fakes/runtime.ts",
        "packages/core/src/fakes/vcs-reads.ts",
        "packages/core/src/fakes/vcs-seed.ts",
        "packages/core/src/fakes/vcs-writes.ts",
        "packages/core/src/links/tickets.ts",
        "packages/core/src/permissions/adb.ts",
        "packages/core/src/permissions/build.ts",
        "packages/core/src/permissions/command-words.ts",
        "packages/core/src/permissions/evaluate-shell.ts",
        "packages/core/src/permissions/evaluate.ts",
        "packages/core/src/permissions/git-push.ts",
        "packages/core/src/permissions/git.ts",
        "packages/core/src/permissions/packs.ts",
        "packages/core/src/permissions/paths.ts",
        "packages/core/src/permissions/rule-match.ts",
        "packages/core/src/permissions/secrets.ts",
        "packages/core/src/permissions/shell-expansion.ts",
        "packages/core/src/permissions/shell-tokens.ts",
        "packages/core/src/permissions/shell.ts",
        "packages/core/src/permissions/tool-options.ts",
        "packages/core/src/permissions/tools.ts",
        "packages/core/src/policies/approvers.ts",
        "packages/core/src/policies/describe.ts",
        "packages/core/src/render/__tests__/render.test.ts",
        "packages/core/src/render/frontmatter.ts",
        "packages/core/src/render/render.ts",
        "packages/core/src/workflow/__tests__/workflow.test.ts",
        "packages/core/src/workflow/evaluate-actions.ts",
        "packages/core/src/workflow/evaluate-check.ts",
        "packages/core/src/workflow/evaluate.ts",
        "packages/core/src/workflow/validate.ts",
        "packages/office/src/link/client.ts",
        "packages/office/src/link/events.ts",
        "packages/office/src/pipeline/conditions.ts",
        "packages/office/src/pipeline/configure.ts",
        "packages/office/src/pipeline/decide.ts",
        "packages/office/src/pipeline/derive.ts",
        "packages/office/src/pipeline/describe.ts",
        "packages/office/src/pipeline/instructions.ts",
        "packages/office/src/pipeline/replay/replay.ts",
        "packages/protocol/src/link/codec.ts"
      ],
      "rules": {
        "eslint/complexity": "off",
        "eslint/max-depth": "off"
      }
    }
  ],
  "rules": {
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css"]
      }
    ],
    "curly": ["error", "all"],
    "arrow-body-style": ["error", "as-needed"],
    "@stylistic/no-multiple-empty-lines": [
      "error",
      {
        "max": 1,
        "maxBOF": 0,
        "maxEOF": 0
      }
    ],
    "@stylistic/padding-line-between-statements": [
      "error",
      {
        "blankLine": "always",
        "prev": ["if", "for", "while", "do", "try", "switch"],
        "next": "*"
      },
      {
        "blankLine": "always",
        "prev": "multiline-const",
        "next": "*"
      },
      {
        "blankLine": "always",
        "prev": "multiline-let",
        "next": "*"
      },
      {
        "blankLine": "always",
        "prev": "multiline-var",
        "next": "*"
      },
      {
        "blankLine": "always",
        "prev": "multiline-expression",
        "next": "*"
      },
      {
        "blankLine": "always",
        "prev": "multiline-block-like",
        "next": "*"
      },
      {
        "blankLine": "always",
        "prev": "multiline-export",
        "next": "*"
      },
      {
        "blankLine": "always",
        "prev": "block-like",
        "next": "return"
      }
    ],
    "@stylistic/lines-around-comment": [
      "error",
      {
        "beforeBlockComment": true,
        "beforeLineComment": false,
        "afterBlockComment": false,
        "afterLineComment": false,
        "allowBlockStart": true,
        "allowClassStart": true,
        "allowObjectStart": true,
        "allowArrayStart": true,
        "allowInterfaceStart": true,
        "allowTypeStart": true,
        "allowEnumStart": true,
        "allowModuleStart": true,
        "applyDefaultIgnorePatterns": true
      }
    ],
    "eslint/complexity": [
      "error",
      {
        "max": 8
      }
    ],
    "eslint/max-depth": [
      "error",
      {
        "max": 3
      }
    ]
  }
}
