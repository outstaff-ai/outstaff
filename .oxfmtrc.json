{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "sortPackageJson": false,
  "ignorePatterns": [
    "docs/src/content/docs/reference/cli.md",
    "docs/src/content/docs/reference/team-yaml.md",
    "docs/src/content/docs/reference/validation-codes.md",
    "**/__golden__",
    "**/__snapshots__",
    "packages/core/schema",
    "node_modules",
    "dist",
    "build",
    "coverage",
    ".astro",
    "pnpm-lock.yaml",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
