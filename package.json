{
  "name": "outstaff-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "license": "MIT",
  "scripts": {
    "lint": "oxlint",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck",
    "test": "vitest run",
    "build": "pnpm -r run build",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.2",
    "oxlint": "1.89.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  }
}
