# Copy to .env (gitignored). Used by compose.yaml.
# Letters and digits only, or percent-encode it: it becomes part of the office's Postgres URL.
POSTGRES_PASSWORD=change-me

# Optional. Defaults build from the repository; set these to run released images instead.
# OUTSTAFF_OFFICE_IMAGE=ghcr.io/outstaff-ai/office:1.2.3
# OUTSTAFF_AGENT_IMAGE=ghcr.io/outstaff-ai/agent:1.2.3
# Where team.yaml lives (default: the acme example) and where the secret files are (default: ./secrets; in your own repository, the .outstaff/secrets folder that `ost setup` fills).
# OUTSTAFF_TEAM_DIR=/srv/acme/.outstaff
# SECRETS_DIR=/srv/acme/secrets
