{
  "name": "@outstaff/core",
  "version": "0.0.0",
  "description": "Schema, config, renderer, policies and ports for Outstaff.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outstaff-ai/outstaff.git",
    "directory": "packages/core"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./fakes": {
      "types": "./dist/fakes/index.d.ts",
      "default": "./dist/fakes/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "schema": "tsx scripts/gen-schema.ts",
    "docs:schema": "tsx scripts/gen-docs.ts"
  },
  "dependencies": {
    "semver": "7.8.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/semver": "7.8.0",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "vitest": "^5.0.5"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
