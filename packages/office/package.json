{
  "name": "@outstaff/office",
  "version": "0.0.0",
  "description": "The Outstaff office scheduler service.",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outstaff-ai/outstaff.git",
    "directory": "packages/office"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@outstaff/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#/*": {
      "@outstaff/source": "./src/*",
      "default": "./dist/*"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "docs:contract": "tsx --conditions=@outstaff/source scripts/gen-contract-docs.ts",
    "docs:pipeline": "tsx --conditions=@outstaff/source scripts/gen-pipeline-docs.ts",
    "prepack": "node ../../scripts/copy-legal.mjs"
  },
  "dependencies": {
    "@outstaff/catalog": "workspace:*",
    "@outstaff/core": "workspace:*",
    "@outstaff/integration.chat.slack": "workspace:*",
    "@outstaff/integration.knowledge.itsaplan": "workspace:*",
    "@outstaff/integration.tracker.itsaplan": "workspace:*",
    "@outstaff/integration.vcs.github": "workspace:*",
    "@outstaff/protocol": "workspace:*",
    "kysely": "0.29.7",
    "pg": "8.23.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "@outstaff/agent": "workspace:*",
    "@outstaff/testing.office": "workspace:*",
    "tsx": "4.23.15"
  },
  "bin": {
    "outstaff-office": "./dist/main.js"
  }
}
