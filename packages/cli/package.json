{
  "name": "outstaff",
  "version": "0.0.0",
  "description": "Command line interface for Outstaff.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outstaff-ai/outstaff.git",
    "directory": "packages/cli"
  },
  "files": [
    "dist"
  ],
  "scripts": {
