{
  "name": "outstaff",
  "version": "0.0.0",
  "description": "Command line interface for Outstaff.",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outstaff-ai/outstaff.git",
    "directory": "packages/cli"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "imports": {
    "#/*": {
      "@outstaff/source": "./src/*",
      "default": "./dist/*"
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "docs:cli": "tsx --conditions=@outstaff/source scripts/gen-cli-docs.ts",
    "prepack": "node ../../scripts/copy-legal.mjs"
  },
  "bin": {
    "outstaff": "./dist/cli.js",
    "ost": "./dist/cli.js"
  },
  "dependencies": {
    "@commander-js/extra-typings": "15.0.0",
    "@outstaff/agent": "workspace:*",
    "@outstaff/catalog": "workspace:*",
    "@outstaff/core": "workspace:*",
    "@outstaff/integration.avatars.dicebear": "workspace:*",
    "@outstaff/integration.chat.slack": "workspace:*",
    "@outstaff/integration.knowledge.itsaplan": "workspace:*",
    "@outstaff/integration.runtime.claude": "workspace:*",
    "@outstaff/integration.tracker.itsaplan": "workspace:*",
    "@outstaff/integration.vcs.github": "workspace:*",
    "@outstaff/protocol": "workspace:*",
    "commander": "15.0.0",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@outstaff/office": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@outstaff/office": {
      "optional": true
    }
  },
  "devDependencies": {
    "@outstaff/office": "workspace:*",
    "@outstaff/testing.agent": "workspace:*",
    "@outstaff/testing.core": "workspace:*",
    "@outstaff/testing.office": "workspace:*",
    "tsx": "4.23.15"
  }
}
