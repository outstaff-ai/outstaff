{
  "name": "outstaff",
  "version": "0.0.0",
  "description": "Command line interface for Outstaff.",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outstaff-ai/outstaff.git",
    "directory": "packages/cli"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "docs:cli": "tsx scripts/gen-cli-docs.ts",
    "prepack": "node ../../scripts/copy-legal.mjs"
  },
  "bin": {
    "outstaff": "./dist/cli.js",
    "ost": "./dist/cli.js"
  },
  "dependencies": {
    "@commander-js/extra-typings": "15.0.0",
    "@outstaff/agent": "workspace:*",
    "@outstaff/avatars-dicebear": "workspace:*",
    "@outstaff/catalog": "workspace:*",
    "@outstaff/chat-slack": "workspace:*",
    "@outstaff/core": "workspace:*",
    "@outstaff/runtime-agent-sdk": "workspace:*",
    "@outstaff/tracker-itsaplan": "workspace:*",
    "@outstaff/vcs-github": "workspace:*",
    "commander": "15.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
