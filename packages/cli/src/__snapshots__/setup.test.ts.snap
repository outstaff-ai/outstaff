// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ost setup template > lists no GitHub keys for a person without repository grants 1`] = `
"# Outstaff credentials for leo on acme. Generated by \`ost setup leo\`; never put real values in this file.
#
# Preferred: one file per key in a secrets directory, named after the key, holding only the value.
# The container reads them from /run/secrets/outstaff or from OUTSTAFF_SECRETS_DIR.
#
#   .outstaff/secrets/leo/
#     OUTSTAFF_AGENT_TOKEN
#     SLACK_BOT_TOKEN
#     SLACK_APP_TOKEN
#     SLACK_BOT_USER_ID
#     ANTHROPIC_API_KEY
#     CLAUDE_CODE_OAUTH_TOKEN
#     ITSAPLAN_API_KEY
#     ITSAPLAN_MEMBER_ID
#
# Fallback for platforms that can only inject environment variables: copy this file to \`.env\`,
# fill it in and keep it out of git. Anything in the environment is visible to the agent's shell.

# --- outstaff ---

# This person's token for the office, the same value the office holds as OUTSTAFF_AGENT_TOKEN_<HANDLE>. Choose a long random value.
# Where: Generate it yourself, for example with \`openssl rand -hex 32\`.
# Required.
OUTSTAFF_AGENT_TOKEN=

# --- slack (chat) ---

# Bot User OAuth Token of this person's Slack app (xoxb-...).
# Where: api.slack.com/apps > the app > OAuth & Permissions.
# Required.
SLACK_BOT_TOKEN=

# App-level token with connections:write, for Socket Mode (xapp-...).
# Where: api.slack.com/apps > the app > Basic Information > App-Level Tokens.
# Required.
SLACK_APP_TOKEN=

# Slack member id of this person's bot user.
# Where: Let ost setup --derive look it up (auth.test), or the app's member profile.
# Optional. Derivable. Leave it empty and run \`ost setup leo --derive\`.
SLACK_BOT_USER_ID=

# --- claude-agent-sdk (runtime) ---

# Anthropic API key. Use this, a cloud provider or a subscription token; the adapter itself never reads it.
# Where: Anthropic Console. Give it to the container as an environment variable or secret file.
# Optional.
ANTHROPIC_API_KEY=

# Long-lived subscription token for this container. Use it within the provider's terms.
# Where: Run \`claude setup-token\` on a machine signed in to your own subscription.
# Optional.
CLAUDE_CODE_OAUTH_TOKEN=

# --- itsaplan (tracker) ---

# API key of this agent's own member account in Its a Plan.
# Where: Its a Plan > Account settings > API keys, signed in as that member (the key is shown once).
# Required.
ITSAPLAN_API_KEY=

# Member id of the account the API key belongs to.
# Where: Let ost setup --derive look it up (/me).
# Optional. Derivable. Leave it empty and run \`ost setup leo --derive\`.
ITSAPLAN_MEMBER_ID=
"
`;

exports[`ost setup template > lists the keys a person needs, with a comment each 1`] = `
"# Outstaff credentials for mira on acme. Generated by \`ost setup mira\`; never put real values in this file.
#
# Preferred: one file per key in a secrets directory, named after the key, holding only the value.
# The container reads them from /run/secrets/outstaff or from OUTSTAFF_SECRETS_DIR.
#
#   .outstaff/secrets/mira/
#     OUTSTAFF_AGENT_TOKEN
#     SLACK_BOT_TOKEN
#     SLACK_APP_TOKEN
#     SLACK_BOT_USER_ID
#     GH_APP_ID
#     GH_APP_PRIVATE_KEY
#     GH_APP_PRIVATE_KEY_FILE
#     GH_APP_INSTALLATION_ID
#     GH_APP_BOT_EMAIL
#     GH_APP_SLUG
#     GH_OFFICE_APP_ID
#     GH_OFFICE_APP_PRIVATE_KEY
#     GH_OFFICE_APP_PRIVATE_KEY_FILE
#     GH_OFFICE_APP_INSTALLATION_ID
#     GH_OFFICE_APP_BOT_EMAIL
#     GH_OFFICE_APP_SLUG
#     ANTHROPIC_API_KEY
#     CLAUDE_CODE_OAUTH_TOKEN
#     ITSAPLAN_API_KEY
#     ITSAPLAN_MEMBER_ID
#
# Fallback for platforms that can only inject environment variables: copy this file to \`.env\`,
# fill it in and keep it out of git. Anything in the environment is visible to the agent's shell.

# --- outstaff ---

# This person's token for the office, the same value the office holds as OUTSTAFF_AGENT_TOKEN_<HANDLE>. Choose a long random value.
# Where: Generate it yourself, for example with \`openssl rand -hex 32\`.
# Required.
OUTSTAFF_AGENT_TOKEN=

# --- slack (chat) ---

# Bot User OAuth Token of this person's Slack app (xoxb-...).
# Where: api.slack.com/apps > the app > OAuth & Permissions.
# Required.
SLACK_BOT_TOKEN=

# App-level token with connections:write, for Socket Mode (xapp-...).
# Where: api.slack.com/apps > the app > Basic Information > App-Level Tokens.
# Required.
SLACK_APP_TOKEN=

# Slack member id of this person's bot user.
# Where: Let ost setup --derive look it up (auth.test), or the app's member profile.
# Optional. Derivable. Leave it empty and run \`ost setup mira --derive\`.
SLACK_BOT_USER_ID=

# --- github (vcs) ---

# Numeric id of this person's own GitHub App.
# Where: GitHub > Settings > Developer settings > GitHub Apps > your app > About.
# Required.
GH_APP_ID=

# Private key (PEM text) of this person's own GitHub App; use this or GH_APP_PRIVATE_KEY_FILE.
# Where: The App's page > Private keys > Generate a private key.
# Required.
GH_APP_PRIVATE_KEY=

# Path to the private key PEM file, as an alternative to GH_APP_PRIVATE_KEY.
# Where: The file downloaded when generating the key.
# Required.
GH_APP_PRIVATE_KEY_FILE=

# Installation id of this person's own GitHub App on the team's account.
# Where: The number in the installation URL, or let ost setup --derive look it up.
# Required. Derivable. Leave it empty and run \`ost setup mira --derive\`.
GH_APP_INSTALLATION_ID=

# Commit email of the bot of this person's own GitHub App: <bot id>+<slug>[bot]@users.noreply.github.com.
# Where: Let ost setup --derive look it up.
# Optional. Derivable. Leave it empty and run \`ost setup mira --derive\`.
GH_APP_BOT_EMAIL=

# URL slug of this person's own GitHub App (its bot is <slug>[bot]).
# Where: The App's public page URL, or let ost setup --derive look it up.
# Required. Derivable. Leave it empty and run \`ost setup mira --derive\`.
GH_APP_SLUG=

# Numeric id of the team's read-only office GitHub App.
# Where: GitHub > Settings > Developer settings > GitHub Apps > the office app > About.
# Required.
GH_OFFICE_APP_ID=

# Private key (PEM text) of the team's read-only office GitHub App; use this or GH_OFFICE_APP_PRIVATE_KEY_FILE.
# Where: The App's page > Private keys > Generate a private key.
# Required.
GH_OFFICE_APP_PRIVATE_KEY=

# Path to the private key PEM file, as an alternative to GH_OFFICE_APP_PRIVATE_KEY.
# Where: The file downloaded when generating the key.
# Required.
GH_OFFICE_APP_PRIVATE_KEY_FILE=

# Installation id of the team's read-only office GitHub App on the team's account.
# Where: The number in the installation URL, or let ost setup --derive look it up.
# Required. Derivable. Leave it empty and run \`ost setup mira --derive\`.
GH_OFFICE_APP_INSTALLATION_ID=

# Commit email of the bot of the team's read-only office GitHub App: <bot id>+<slug>[bot]@users.noreply.github.com.
# Where: Let ost setup --derive look it up.
# Optional. Derivable. Leave it empty and run \`ost setup mira --derive\`.
GH_OFFICE_APP_BOT_EMAIL=

# URL slug of the team's read-only office GitHub App (its bot is <slug>[bot]).
# Where: The App's public page URL, or let ost setup --derive look it up.
# Required. Derivable. Leave it empty and run \`ost setup mira --derive\`.
GH_OFFICE_APP_SLUG=

# --- claude-agent-sdk (runtime) ---

# Anthropic API key. Use this, a cloud provider or a subscription token; the adapter itself never reads it.
# Where: Anthropic Console. Give it to the container as an environment variable or secret file.
# Optional.
ANTHROPIC_API_KEY=

# Long-lived subscription token for this container. Use it within the provider's terms.
# Where: Run \`claude setup-token\` on a machine signed in to your own subscription.
# Optional.
CLAUDE_CODE_OAUTH_TOKEN=

# --- itsaplan (tracker) ---

# API key of this agent's own member account in Its a Plan.
# Where: Its a Plan > Account settings > API keys, signed in as that member (the key is shown once).
# Required.
ITSAPLAN_API_KEY=

# Member id of the account the API key belongs to.
# Where: Let ost setup --derive look it up (/me).
# Optional. Derivable. Leave it empty and run \`ost setup mira --derive\`.
ITSAPLAN_MEMBER_ID=
"
`;

exports[`ost setup template > lists the office's keys, one agent token per person, the office Slack token and no runtime keys 1`] = `
"# Outstaff credentials for the acme office. Generated by \`ost setup office\`; never put real values in this file.
#
# Preferred: one file per key in a secrets directory, named after the key, holding only the value.
# The container reads them from /run/secrets/outstaff or from OUTSTAFF_SECRETS_DIR.
#
#   .outstaff/secrets/office/
#     OUTSTAFF_AGENT_TOKEN_PRIYA
#     OUTSTAFF_AGENT_TOKEN_TOMAS
#     OUTSTAFF_AGENT_TOKEN_MIRA
#     OUTSTAFF_AGENT_TOKEN_LEO
#     OUTSTAFF_AGENT_TOKEN_SAM
#     OUTSTAFF_AGENT_TOKEN_NOOR
#     OUTSTAFF_AGENT_TOKEN_INES
#     OUTSTAFF_AGENT_TOKEN_KOFI
#     SLACK_OFFICE_BOT_TOKEN
#     GH_OFFICE_APP_ID
#     GH_OFFICE_APP_PRIVATE_KEY
#     GH_OFFICE_APP_PRIVATE_KEY_FILE
#     GH_OFFICE_APP_INSTALLATION_ID
#     GH_OFFICE_APP_BOT_EMAIL
#     GH_OFFICE_APP_SLUG
#     ITSAPLAN_API_KEY
#     ITSAPLAN_MEMBER_ID
#
# Fallback for platforms that can only inject environment variables: copy this file to \`.env\`,
# fill it in and keep it out of git. Anything in the environment is visible to the agent's shell.

# --- outstaff ---

# Token that lets Priya Raman (priya) connect to the office; give the same value to that agent as OUTSTAFF_AGENT_TOKEN.
# Where: Generate it yourself, for example with \`openssl rand -hex 32\`.
# Required.
OUTSTAFF_AGENT_TOKEN_PRIYA=

# Token that lets Tomas Novak (tomas) connect to the office; give the same value to that agent as OUTSTAFF_AGENT_TOKEN.
# Where: Generate it yourself, for example with \`openssl rand -hex 32\`.
# Required.
OUTSTAFF_AGENT_TOKEN_TOMAS=

# Token that lets Mira Okafor (mira) connect to the office; give the same value to that agent as OUTSTAFF_AGENT_TOKEN.
# Where: Generate it yourself, for example with \`openssl rand -hex 32\`.
# Required.
OUTSTAFF_AGENT_TOKEN_MIRA=

# Token that lets Leo Fischer (leo) connect to the office; give the same value to that agent as OUTSTAFF_AGENT_TOKEN.
# Where: Generate it yourself, for example with \`openssl rand -hex 32\`.
# Required.
OUTSTAFF_AGENT_TOKEN_LEO=

# Token that lets Sam Duarte (sam) connect to the office; give the same value to that agent as OUTSTAFF_AGENT_TOKEN.
# Where: Generate it yourself, for example with \`openssl rand -hex 32\`.
# Required.
OUTSTAFF_AGENT_TOKEN_SAM=

# Token that lets Noor Haddad (noor) connect to the office; give the same value to that agent as OUTSTAFF_AGENT_TOKEN.
# Where: Generate it yourself, for example with \`openssl rand -hex 32\`.
# Required.
OUTSTAFF_AGENT_TOKEN_NOOR=

# Token that lets Ines Varga (ines) connect to the office; give the same value to that agent as OUTSTAFF_AGENT_TOKEN.
# Where: Generate it yourself, for example with \`openssl rand -hex 32\`.
# Required.
OUTSTAFF_AGENT_TOKEN_INES=

# Token that lets Kofi Mensah (kofi) connect to the office; give the same value to that agent as OUTSTAFF_AGENT_TOKEN.
# Where: Generate it yourself, for example with \`openssl rand -hex 32\`.
# Required.
OUTSTAFF_AGENT_TOKEN_KOFI=

# --- slack (chat) ---

# Bot User OAuth Token of the team's office Slack app (xoxb-...); it posts and reads channel history only.
# Where: api.slack.com/apps > the office app > OAuth & Permissions.
# Required.
SLACK_OFFICE_BOT_TOKEN=

# --- github (vcs) ---

# Numeric id of the team's read-only office GitHub App.
# Where: GitHub > Settings > Developer settings > GitHub Apps > the office app > About.
# Required.
GH_OFFICE_APP_ID=

# Private key (PEM text) of the team's read-only office GitHub App; use this or GH_OFFICE_APP_PRIVATE_KEY_FILE.
# Where: The App's page > Private keys > Generate a private key.
# Required.
GH_OFFICE_APP_PRIVATE_KEY=

# Path to the private key PEM file, as an alternative to GH_OFFICE_APP_PRIVATE_KEY.
# Where: The file downloaded when generating the key.
# Required.
GH_OFFICE_APP_PRIVATE_KEY_FILE=

# Installation id of the team's read-only office GitHub App on the team's account.
# Where: The number in the installation URL, or let ost setup --derive look it up.
# Required. Derivable. Leave it empty and run \`ost setup office --derive\`.
GH_OFFICE_APP_INSTALLATION_ID=

# Commit email of the bot of the team's read-only office GitHub App: <bot id>+<slug>[bot]@users.noreply.github.com.
# Where: Let ost setup --derive look it up.
# Optional. Derivable. Leave it empty and run \`ost setup office --derive\`.
GH_OFFICE_APP_BOT_EMAIL=

# URL slug of the team's read-only office GitHub App (its bot is <slug>[bot]).
# Where: The App's public page URL, or let ost setup --derive look it up.
# Required. Derivable. Leave it empty and run \`ost setup office --derive\`.
GH_OFFICE_APP_SLUG=

# --- itsaplan (tracker) ---

# API key of the member account the office acts as.
# Where: Its a Plan > Account settings > API keys, signed in as that member (the key is shown once).
# Required.
ITSAPLAN_API_KEY=

# Member id of the account the API key belongs to.
# Where: Let ost setup --derive look it up (/me).
# Optional. Derivable. Leave it empty and run \`ost setup office --derive\`.
ITSAPLAN_MEMBER_ID=
"
`;

exports[`ost setup template > prints a guide for each configured adapter 1`] = `
"Wrote .outstaff/people/mira/.env.example
Secret files go in .outstaff/secrets/mira/, one file per key.

## slack (chat)

1. Create Mira Okafor's Slack app

   Go to https://api.slack.com/apps, Create New App > From a manifest, pick the workspace, switch to the YAML tab and paste the manifest. It turns on Socket Mode, so the agent connects out and no public URL is needed.

   Paste or follow:

   \`\`\`
   display_information:
     name: "Mira Okafor"
     description: "architect on the acme team"
   features:
     app_home:
       home_tab_enabled: true
       messages_tab_enabled: true
       messages_tab_read_only_enabled: false
     bot_user:
       display_name: "mira"
       always_online: true
   oauth_config:
     scopes:
       bot:
         - app_mentions:read
         - chat:write
         - im:history
         - im:read
         - im:write
         - reactions:write
         - users:read
   settings:
     event_subscriptions:
       bot_events:
         - app_home_opened
         - app_mention
         - message.im
     socket_mode_enabled: true
     org_deploy_enabled: false
     token_rotation_enabled: false
   \`\`\`

2. Create the app-level token

   Basic Information > App-Level Tokens > Generate Token and Scopes, with the \`connections:write\` scope. Keep the \`xapp-...\` token as \`SLACK_APP_TOKEN\`.

3. Install the app and copy the bot token

   Install App > Install to Workspace. Keep the Bot User OAuth Token (\`xoxb-...\`) from OAuth & Permissions as \`SLACK_BOT_TOKEN\`. \`ost setup --derive\` fills \`SLACK_BOT_USER_ID\` from it.

## github (vcs)

1. Create Mira Okafor's GitHub App

   Open GitHub > Settings (or the organization's settings) > Developer settings > GitHub Apps > New GitHub App. Name it \`acme-mira\`, leave the webhook off, and set these repository permissions, which are the only ones the adapter uses: metadata, checks and commit statuses read-only; contents, pull requests and issues read and write (pull requests are commented on through the issues API). Set "Where can this GitHub App be installed" to "Only on this account". The manifest below lists the same settings; GitHub only takes it through the app-manifest flow, so use it as the checklist.

   Paste or follow:

   \`\`\`
   {
     "name": "acme-mira",
     "url": "https://github.com",
     "public": false,
     "hook_attributes": {
       "url": "https://example.invalid/unused",
       "active": false
     },
     "default_permissions": {
       "metadata": "read",
       "contents": "write",
       "pull_requests": "write",
       "issues": "write",
       "checks": "read",
       "statuses": "read"
     },
     "default_events": []
   }
   \`\`\`

2. Install it on exactly the repositories this person can write

   Install App, pick the owning account, "Only select repositories": \`github.com/acme-example/shop\`. Nothing else: the App carries write permissions, and a GitHub App's permissions are per installation, not per repository, so the repository list is the real boundary. Read access comes from the office App, so read-only repositories do not belong on this installation.

3. Generate a private key and copy the keys

   Private keys > Generate a private key. Keep the App id as \`GH_APP_ID\`. Keep the private key as \`GH_APP_PRIVATE_KEY\` (a file named that in your secrets directory holding the PEM text) or point \`GH_APP_PRIVATE_KEY_FILE\` at the file. \`ost setup --derive\` fills \`GH_APP_SLUG\`, \`GH_APP_INSTALLATION_ID\` and \`GH_APP_BOT_EMAIL\` from them, and offers to move a freshly downloaded \`*.pem\` for the App from your Downloads folder.

4. Add the office App's keys

   Agents clone read-granted repositories with the shared read-only office App. Put the same \`GH_OFFICE_APP_*\` values the office uses in this person's secrets (see \`ost setup office\`).

## claude-agent-sdk (runtime)

1. Choose how this agent signs in to Claude

   Outstaff never asks for, stores or brokers model credentials. Supply exactly one of these to the agent container:

   - **API key**: create it in the Anthropic Console and keep it as \`ANTHROPIC_API_KEY\`.
   - **Cloud provider**: Amazon Bedrock, Google Vertex AI or Microsoft Foundry. Set the provider's switch and region as plain environment variables (for example \`CLAUDE_CODE_USE_BEDROCK=1\`, \`AWS_REGION\`) and give its credentials as secret files.
   - **Your own subscription token**: run \`claude setup-token\` on a machine signed in to your subscription and keep the result as \`CLAUDE_CODE_OAUTH_TOKEN\`. Use it only within the provider's terms (https://www.anthropic.com/legal/consumer-terms and https://www.anthropic.com/legal/commercial-terms); a subscription is meant for its owner, not for a fleet of agents.

   Commands the agent runs can read this credential unless the runtime's \`sandbox\` option is \`bubblewrap\`, so use a dedicated key with a spend limit and rotate it if it leaks.

## itsaplan (tracker)

1. Give Mira Okafor a member account

   Its a Plan is invite-only, so one human step is needed once. Pick an address you control, for example \`<you>+mira@<your domain>\` (plus-addressing on your own mailbox) or \`mira@agents.<your domain>\` forwarded to you (for example with Cloudflare Email Routing). No mailbox is run by Outstaff. Invite that address to the team and to the project: Team settings > Members, then the project's members. The invite lands in a human's inbox.

2. A human accepts the invite

   Open the invite, accept it and finish the account (name, avatar). Use \`mira\` as the username, so Outstaff recognises the member as an agent. Give the member only the projects it works in, and let it read the project's activity feed (the dashboards permission), which the office uses to see events.

3. Create the API key

   Signed in as that member: Account settings > API keys > create. The key is shown once; keep it as \`ITSAPLAN_API_KEY\`. \`ost setup --derive\` then fills \`ITSAPLAN_MEMBER_ID\` from it.

avatars/dicebear: not shipped in this build, so no secrets or guide are listed for it.
When the keys are in place, run \`ost setup mira --derive\` for the rest.
"
`;
