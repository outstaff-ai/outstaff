{
  "name": "@outstaff/catalog",
  "version": "0.0.0",
  "description": "Roles and skills content for Outstaff.",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outstaff-ai/outstaff.git",
    "directory": "packages/catalog"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@outstaff/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./toolsets/*": "./toolsets/*",
    "./package.json": "./package.json"
  },
  "imports": {
    "#/*": {
      "@outstaff/source": "./src/*",
      "default": "./dist/*"
    }
  },
  "files": [
    "dist",
    "process",
    "references",
    "roles",
    "templates",
    "toolsets",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "node ../../scripts/copy-legal.mjs"
  }
}
