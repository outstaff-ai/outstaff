{
  "name": "@outstaff/testing.office",
  "version": "0.0.0",
  "description": "Office test kit: an in-memory work source for tests of the agent protocol server. Private: never packed or published.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
