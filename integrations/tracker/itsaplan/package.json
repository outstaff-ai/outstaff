{
  "name": "@outstaff/integration.tracker.itsaplan",
  "version": "0.0.0",
  "description": "Its a Plan adapter for the Outstaff tracker port, and the REST client the knowledge adapter shares.",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outstaff-ai/outstaff.git",
    "directory": "integrations/tracker/itsaplan"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@outstaff/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#/*": {
      "@outstaff/source": "./src/*",
      "default": "./dist/*"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "node ../../../scripts/copy-legal.mjs"
  },
  "dependencies": {
    "@outstaff/core": "workspace:*",
    "@outstaff/integration.shared.itsaplan": "workspace:*"
  },
  "devDependencies": {
    "@outstaff/testing.itsaplan": "workspace:*",
    "vitest": "5.0.5"
  }
}
