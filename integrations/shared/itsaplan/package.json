{
  "name": "@outstaff/integration.shared.itsaplan",
  "version": "0.0.0",
  "description": "The Its a Plan client both Its a Plan adapters share: REST client and rate-limit pacer, connection options, link templates, cursors, API types, setup guide, doctor checks and secrets.",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outstaff-ai/outstaff.git",
    "directory": "integrations/shared/itsaplan"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "node ../../../scripts/copy-legal.mjs"
  },
  "dependencies": {
    "@outstaff/core": "workspace:*",
    "undici": "8.12.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "vitest": "5.0.5"
  }
}
